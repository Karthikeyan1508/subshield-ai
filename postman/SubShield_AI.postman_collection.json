{
  "info": {
    "name": "SubShield AI",
    "description": "Sandbox API for the SubShield AI subscription ledger. Set the baseUrl variable (local: http://localhost:4000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "subscriptionId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "List subscriptions",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/subscriptions" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const subs = pm.response.json();",
              "pm.test('array with score 0-100', () => {",
              "  pm.expect(subs).to.be.an('array');",
              "  subs.forEach(s => pm.expect(s.predatoryScore).to.be.within(0, 100));",
              "});",
              "if (subs.length) pm.collectionVariables.set('subscriptionId', subs[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel subscription",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/cancel" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 502 is expected for a subscription the buyer never approved.",
              "pm.test('200 cancelled or 502 not cancellable', () => pm.expect([200, 502]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel unknown subscription",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/subscriptions/does-not-exist/cancel" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));",
              "pm.test('error message', () => pm.expect(pm.response.json().error).to.eql('unknown subscription'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Run alerts",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/alerts/run" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with sent list or 503 without webhook', () => {",
              "  pm.expect([200, 503]).to.include(pm.response.code);",
              "  if (pm.response.code === 200) pm.expect(pm.response.json().sent).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
